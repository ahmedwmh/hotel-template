# Supabase (PostgreSQL) - never commit real values
# Pooled connection for the app
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# Direct connection for migrations and introspection
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Auth (required for admin login — copy to .env, min 32 chars)
AUTH_SECRET="generate-with-openssl-rand-base64-32"



# Supabase Storage (admin image uploads: carousel, rooms, facilities, blog, testimonials)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=your_anon_or_publishable_key
BUCKET_NAME=uploads
# Optional: use service role key for server-side uploads (never expose in client)
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Seed: admin user (optional; defaults: admin@najafhotel.com / Admin123!)
# ADMIN_EMAIL="admin@najafhotel.com"
# ADMIN_PASSWORD="Admin123!"
